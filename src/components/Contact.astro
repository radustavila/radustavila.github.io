---
import Icon from './Icon.astro';
import { contact, links, profile } from '../data/portfolio';

const year = new Date().getFullYear();
---

<section class="section contact on-dark" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal>05 · Contact</p>
    <h2 id="contact-title" data-reveal>{contact.heading}</h2>
    <p class="body" data-reveal>{contact.body}</p>

    <a class="email" href={`mailto:${links.email}`} data-reveal>
      <Icon name="mail" />
      <span>{links.email}</span>
    </a>

    <ul class="channels" data-reveal>
      <li>
        <a href={links.linkedin} rel="noopener me">
          <Icon name="linkedin" />
          <span>
            <strong>LinkedIn</strong>
            <small>in/radu-stavila</small>
          </span>
        </a>
      </li>
      <li>
        <a href={links.github} rel="noopener me">
          <Icon name="github" />
          <span>
            <strong>GitHub</strong>
            <small>radustavila</small>
          </span>
        </a>
      </li>
      <li>
        <a href={links.xpiryPlay} rel="noopener">
          <Icon name="play" />
          <span>
            <strong>Google Play</strong>
            <small>Xpiry</small>
          </span>
        </a>
      </li>
      <li>
        <div>
          <Icon name="pin" />
          <span>
            <strong>Location</strong>
            <small>{profile.location}</small>
          </span>
        </div>
      </li>
    </ul>
  </div>

  <footer class="wrap footer">
    <p>© {year} {profile.name}</p>
    <a href="#top">Back to top ↑</a>
  </footer>
</section>

<style>
  .contact {
    padding-bottom: 0;
    background: var(--dark);
    color: var(--on-dark);
  }

  h2 {
    margin-top: 1rem;
    max-width: 14ch;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .body {
    margin-top: 1.5rem;
    max-width: 50ch;
    color: var(--on-dark-muted);
  }

  .email {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    margin-top: 2.25rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--android);
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 4.4vw, 2.4rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--android);
    transition: color 0.2s var(--ease);
  }

  .email span {
    overflow-wrap: anywhere;
  }

  .email :global(svg) {
    width: 0.7em;
    height: 0.7em;
    flex: none;
    transition: transform 0.25s var(--ease);
  }

  .email:hover {
    color: var(--on-dark);
  }

  .email:hover :global(svg) {
    transform: translateY(-2px);
  }

  .channels {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(3rem, 7vw, 5rem);
    border-top: 1px solid var(--dark-line);
  }

  .channels li + li {
    border-left: 1px solid var(--dark-line);
  }

  .channels a,
  .channels div {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 100%;
    padding: 1.4rem 1.25rem;
    text-decoration: none;
    transition: background-color 0.2s var(--ease);
  }

  .channels li:first-child a {
    padding-left: 0;
  }

  .channels a:hover {
    background: var(--dark-2);
  }

  .channels li:first-child a:hover {
    box-shadow: -1.25rem 0 0 var(--dark-2);
  }

  .channels :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    color: var(--android);
  }

  .channels span {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .channels strong {
    font-weight: 550;
    line-height: 1.3;
  }

  .channels small {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--on-dark-muted);
    overflow-wrap: anywhere;
  }

  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--dark-line);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--on-dark-muted);
  }

  .footer a {
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--android);
  }

  @media (max-width: 860px) {
    .channels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .channels li:nth-child(odd) {
      border-left: 0;
    }

    .channels li:nth-child(odd) a,
    .channels li:nth-child(odd) div {
      padding-left: 0;
    }

    .channels li:nth-child(n + 3) {
      border-top: 1px solid var(--dark-line);
    }

    .channels li:first-child a:hover {
      box-shadow: none;
    }
  }

  @media (max-width: 460px) {
    .channels {
      grid-template-columns: minmax(0, 1fr);
    }

    .channels li + li {
      border-left: 0;
      border-top: 1px solid var(--dark-line);
    }

    .channels a,
    .channels div {
      padding-left: 0;
    }
  }
</style>
