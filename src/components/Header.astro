---
import { nav, profile } from '../data/portfolio';

interface Props {
  /** Prefix for section links, so the header also works from pages other than the home page. */
  home?: string;
}

const { home = '' } = Astro.props;
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href={home || '#top'} aria-label={`${profile.name}, back to top`}>
      <span class="brand-mark" aria-hidden="true">R<i></i></span>
      <span class="brand-name">{profile.shortName}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      <span class="sr-only">Menu</span>
      <span class="bars" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Primary" data-nav>
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={`${home}#${item.id}`} data-nav-link={item.id}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4rem;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    font-weight: 550;
    letter-spacing: -0.01em;
  }

  .brand-mark {
    position: relative;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9px;
    background: var(--dark);
    color: var(--paper);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    line-height: 1;
  }

  .brand-mark i {
    position: absolute;
    right: 0.32rem;
    bottom: 0.36rem;
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 50%;
    background: var(--android);
  }

  .nav ul {
    display: flex;
    gap: 0.25rem;
  }

  .nav a {
    display: block;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    font-size: 0.92rem;
    color: var(--ink-2);
    text-decoration: none;
    transition:
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .nav a:hover {
    color: var(--ink);
    background: var(--paper-2);
  }

  .nav a[aria-current='true'] {
    color: var(--paper);
    background: var(--ink);
  }

  .menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.5rem;
    border: 0;
    border-radius: 10px;
    background: transparent;
    cursor: pointer;
  }

  .bars {
    display: grid;
    gap: 6px;
    justify-items: center;
  }

  .bars i {
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.25s var(--ease);
  }

  .menu-toggle[aria-expanded='true'] .bars i:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .bars i:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  @media (max-width: 760px) {
    :global(html.menu-open) {
      overflow: hidden;
    }

    :global(.js) .menu-toggle {
      display: grid;
      place-items: center;
    }

    :global(.js) .nav {
      position: absolute;
      inset: 100% 0 auto 0;
      display: none;
      padding: 0.5rem var(--gutter) 1.25rem;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
    }

    :global(.js) .nav.is-open {
      display: block;
    }

    :global(.js) .nav ul {
      flex-direction: column;
      gap: 0;
    }

    :global(.js) .nav a {
      padding: 0.85rem 0.25rem;
      border-radius: 0;
      border-bottom: 1px solid var(--line);
      font-size: 1.05rem;
    }

    :global(.js) .nav a[aria-current='true'] {
      background: transparent;
      color: var(--green);
    }

    /* Without JS the links stay visible and simply wrap. */
    .bar {
      flex-wrap: wrap;
    }

    .nav ul {
      flex-wrap: wrap;
    }

    .brand-name {
      font-size: 0.98rem;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const navEl = document.querySelector<HTMLElement>('[data-nav]');
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));

  const setMenu = (open: boolean) => {
    navEl?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    // Keep the page behind the open menu from scrolling.
    document.documentElement.classList.toggle('menu-open', open);
  };

  const isOpen = () => toggle?.getAttribute('aria-expanded') === 'true';

  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  navLinks.forEach((link) => link.addEventListener('click', () => setMenu(false)));
  // Tapping anywhere outside the header closes the menu.
  document.addEventListener('click', (event) => {
    if (isOpen() && header && !header.contains(event.target as Node)) setMenu(false);
  });
  // Close it if the viewport grows past the mobile breakpoint.
  window.matchMedia('(max-width: 760px)').addEventListener('change', (event) => {
    if (!event.matches) setMenu(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isOpen()) {
      setMenu(false);
      toggle?.focus();
    }
  });

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Highlight the section currently in view.
  const sections = ['top', ...navLinks.map((link) => link.dataset.navLink ?? '')]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length && 'IntersectionObserver' in window) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          navLinks.forEach((link) => {
            if (link.dataset.navLink === entry.target.id) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
          });
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => spy.observe(section));
  }
</script>
