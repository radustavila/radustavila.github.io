---
import { about } from '../data/portfolio';
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="wrap layout">
    <div class="intro">
      <p class="eyebrow" data-reveal>01 · About</p>
      <h2 class="section-title" id="about-title" data-reveal>An engineer who stays with the product.</h2>
      <div class="prose">
        {about.paragraphs.map((text) => <p data-reveal>{text}</p>)}
      </div>
    </div>

    <ol class="principles">
      {
        about.principles.map((item, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <span class="num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .about {
    border-top: 1px solid var(--line);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2.5rem, 6vw, 5.5rem);
    align-items: start;
  }

  .prose {
    display: grid;
    gap: 1.1rem;
    margin-top: 1.75rem;
    max-width: 60ch;
    color: var(--ink-2);
  }

  .principles {
    display: grid;
    border-top: 1px solid var(--ink);
  }

  .principles li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.5rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--line);
  }

  .num {
    padding-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--green);
  }

  h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 480;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .principles p {
    margin-top: 0.35rem;
    font-size: 0.97rem;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
