---
import Icon from './Icon.astro';
import { profile, links, ledger, stats } from '../data/portfolio';
---

<section class="hero" id="top">
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="wrap">
    <div class="hero-main">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>{profile.role} · {profile.secondaryRole}</p>
        <h1 data-reveal style="--reveal-delay: 60ms">
          <span class="sr-only">{profile.name}. </span>
          {profile.headline.map((line, i) => <span class:list={['line', { accent: i === 0 }]}>{line} </span>)}
        </h1>
        <p class="intro" data-reveal style="--reveal-delay: 120ms">
          <strong>{profile.name}.</strong>
          {profile.intro}
        </p>
        <div class="actions" data-reveal style="--reveal-delay: 180ms">
          <a class="btn btn--solid" href="#work">See selected work <Icon name="arrow" /></a>
          <a class="btn" href={links.github} rel="noopener me"><Icon name="github" /> GitHub</a>
          <a class="btn" href={links.linkedin} rel="noopener me"><Icon name="linkedin" /> LinkedIn</a>
          <a class="btn" href={`mailto:${links.email}`}><Icon name="mail" /> Email</a>
        </div>
      </div>

      <dl class="ledger" data-reveal style="--reveal-delay: 240ms">
        {
          ledger.map((row) => (
            <div class="ledger-row">
              <dt>{row.key}</dt>
              <dd>{row.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <ul class="stats" data-reveal style="--reveal-delay: 300ms">
      {
        stats.map((stat) => (
          <li>
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3rem, 6vw, 5rem);
    overflow: hidden;
  }

  .grid-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, color-mix(in srgb, var(--ink) 16%, transparent) 1px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 80% at 85% 0%, #000 0%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 85% 0%, #000 0%, transparent 70%);
    pointer-events: none;
  }

  .wrap {
    position: relative;
  }

  .hero-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: end;
  }

  h1 {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.6rem, 7.4vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-variation-settings: 'opsz' 144;
  }

  .line {
    display: block;
  }

  .line.accent {
    font-style: italic;
    color: var(--green);
  }

  .intro {
    margin-top: 1.75rem;
    max-width: 58ch;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.6;
    color: var(--ink-2);
  }

  .intro strong {
    color: var(--ink);
    font-weight: 600;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .ledger {
    border-top: 1px solid var(--ink);
    font-size: 0.9rem;
  }

  .ledger-row {
    display: grid;
    grid-template-columns: 4.25rem 1fr;
    gap: 0.75rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }

  .ledger dt {
    padding-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .ledger dd {
    line-height: 1.45;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(3rem, 7vw, 5.5rem);
    border-top: 1px solid var(--line);
  }

  .stats li {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding: 1.4rem 1.25rem 0 0;
  }

  .stats li + li {
    padding-left: 1.25rem;
    border-left: 1px solid var(--line);
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.9rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .stat-label {
    max-width: 22ch;
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .hero-main {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .ledger {
      max-width: 34rem;
    }
  }

  @media (max-width: 700px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats li {
      padding-bottom: 1.4rem;
    }

    .stats li:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .stats li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
</style>
