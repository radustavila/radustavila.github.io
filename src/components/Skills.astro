---
import { skills } from '../data/portfolio';
---

<section class="section skills" id="skills" aria-labelledby="skills-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal>04 · Technical expertise</p>
    <h2 class="section-title" id="skills-title" data-reveal>The tools I use in production.</h2>

    <ul class="groups">
      {
        skills.map((group, i) => (
          <li class="group" data-reveal style={`--reveal-delay: ${(i % 3) * 70}ms`}>
            <h3>
              <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              {group.title}
            </h3>
            <ul class="chip-list">
              {group.items.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .skills {
    background: var(--paper-2);
    border-block: 1px solid var(--line);
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--line);
    overflow: hidden;
  }

  .group {
    padding: 1.6rem 1.5rem 1.75rem;
    background: var(--card);
  }

  h3 {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin-bottom: 1.1rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 460;
    letter-spacing: -0.01em;
  }

  h3 span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--green);
  }

  .chip {
    background: var(--paper);
    font-size: 0.76rem;
  }

  @media (max-width: 900px) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .groups {
      grid-template-columns: 1fr;
    }
  }
</style>
