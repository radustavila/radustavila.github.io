---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import { Content } from '../../legal/spaceterra-terms.md';

const home = import.meta.env.BASE_URL;
---

<Base
  title="Terms of service — SpaceTerra: Universe & Earth"
  description="The terms of service of SpaceTerra: Universe & Earth, the Android app about the universe and Earth."
>
  <Header home={home} />
  <main id="main" class="wrap legal">
    <p class="eyebrow">SpaceTerra: Universe &amp; Earth</p>
    <h1>Terms of service</h1>
    <article class="prose">
      <Content />
    </article>
  </main>
</Base>

<style>
  .legal {
    padding-block: 7rem 5rem;
  }

  h1 {
    margin-block: 1rem 2rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .prose {
    max-width: 72ch;
    color: var(--ink-2);
    line-height: 1.65;
  }

  .prose :global(h2) {
    margin-block: 2.5rem 0.75rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--ink);
  }

  .prose :global(p),
  .prose :global(ul) {
    margin-block: 0 1rem;
  }

  .prose :global(ul) {
    padding-left: 1.25rem;
    list-style: disc;
  }

  .prose :global(li) {
    margin-block: 0.4rem;
  }

  .prose :global(a) {
    color: var(--green);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .prose :global(strong) {
    color: var(--ink);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>
